{
    "configurations": [
        {
            "name": "avr-atmega128",
            "compileCommands": "${workspaceFolder}/build/atmega128-build/compile_commands.json",
            "includePath": [
                "${workspaceFolder}/atmega128/**",
                "/usr/local/include/**",
                "/usr/include/**",
                "/usr/lib/gcc/avr/5.4.0/include/**",
                "/usr/lib/gcc/avr/5.4.0/include-fixed/**",
                "/usr/lib/avr/include/**",
                "${workspaceFolder}/atmega128/deps/arduino-core/cores/arduino/**",
                "${workspaceFolder}/atmega128/deps/arduino-core/variants/**",
                "${workspaceFolder}/atmega128/deps/arduino-core/libraries/**"
            ],
            "browse": {
                "path": [
                    "${workspaceFolder}/atmega128",
                    "/usr/local/include",
                    "/usr/include",
                    "/usr/lib/gcc/avr/5.4.0/include",
                    "/usr/lib/gcc/avr/5.4.0/include-fixed",
                    "/usr/lib/avr/include",
                    "${workspaceFolder}/atmega128/deps/arduino-core/cores/arduino",
                    "${workspaceFolder}/atmega128/deps/arduino-core/variants",
                    "${workspaceFolder}/atmega128/deps/arduino-core/libraries"
                ],
                "limitSymbolsToIncludedHeaders": true,
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db"
            },
            "defines": [
                "F_CPU=16000000UL",
                "__AVR__",
                "__AVR_ATmega128__"
            ],
            "compilerPath": "/usr/bin/avr-gcc",
            "compilerArgs": [
                "-mmcu=atmega128",
                "-DF_CPU=16000000UL"
            ],
            "cStandard": "gnu11",
            "cppStandard": "c++17",
            "intelliSenseMode": "linux-gcc-x64"
        },
        {
            "name": "pico-rp2040",
            "browse": {
                "databaseFilename": "${workspaceFolder}/.vscode/browse.vc.db",
                "limitSymbolsToIncludedHeaders": false
            },
            "compileCommands": [
                "${workspaceFolder}/pico/build/compile_commands.json"
            ],
            "compilerPath": "/opt/homebrew/bin/arm-none-eabi-gcc",
            "cStandard": "gnu11",
            "cppStandard": "c++17",
            "intelliSenseMode": "macos-gcc-arm64"
        }
    ],
    "version": 4
}
