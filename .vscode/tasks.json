{
    "version": "2.0.0",
    "tasks": [
        {
            "type": "shell",
            "label": "AVR: configure atmega128",
            "command": "cmake",
            "args": [
                "-S",
                "${workspaceFolder}/atmega128",
                "-B",
                "${workspaceFolder}/build/atmega128-build",
                "-DCMAKE_TOOLCHAIN_FILE=${workspaceFolder}/atmega128/avr-toolchain.cmake"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "type": "shell",
            "label": "AVR: build atmega128",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/atmega128-build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "AVR: configure atmega128",
            "problemMatcher": [
                "$gcc"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            }
        },
        {
            "type": "shell",
            "label": "AVR: upload atmega128",
            "command": "cmake",
            "args": [
                "--build",
                "${workspaceFolder}/build/atmega128-build",
                "--target",
                "upload"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "dependsOn": "AVR: configure atmega128",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "type": "cppbuild",
            "label": "C/C++: gcc build active file",
            "command": "/usr/bin/gcc",
            "args": [
                "-fdiagnostics-color=always",
                "-g",
                "${file}",
                "-o",
                "${fileDirname}/${fileBasenameNoExtension}"
            ],
            "options": {
                "cwd": "${fileDirname}"
            },
            "problemMatcher": [
                "$gcc"
            ],
            "group": "none",
            "detail": "Generic host GCC build for non-AVR files."
        }
    ]
}
