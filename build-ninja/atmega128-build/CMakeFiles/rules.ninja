#############################################
# Rule for re-running cmake.

rule RERUN_CMAKE
  command = /usr/bin/cmake --regenerate-during-build -S/home/chan/Chanpark2026/atmega128 -B/home/chan/Chanpark2026/build-ninja/atmega128-build
  description = Re-running CMake...
  generator = 1


